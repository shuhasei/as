{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hidden-crew",
  "main": "room.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ]
}
